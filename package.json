{
    "name": "undangan",
    "version": "4.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "lint:js": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:css": "stylelint css",
        "lint:html": "htmlhint **/*.html",
        "typecheck": "tsc --noEmit",
        "circular": "madge --circular --extensions ts,tsx src",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "vite --port 8080",
        "build": "tsc --noEmit && vite build",
        "build:public": "npm run build && node -e \"import('fs-extra').then(({ default: fs }) => fs.ensureDir('public').then(() => Promise.all(['assets', 'css', 'dist', 'index.html'].map((f) => fs.copy(f, 'public/' + f)))).then(() => console.log('✅ Successfully!')))\""
    },
    "dependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^24.0.0",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^6.0.0",
        "eslint": "^9.37.0",
        "fs-extra": "^11.3.2",
        "globals": "^16.4.0",
        "htmlhint": "^1.7.1",
        "jsdom": "^26.1.0",
        "madge": "^8.0.0",
        "stylelint": "^16.25.0",
        "stylelint-config-recommended": "^17.0.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.45.0",
        "vite": "^8.0.0",
        "vitest": "^3.2.4"
    }
}
